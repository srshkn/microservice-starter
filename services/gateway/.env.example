# ./services/gatewat/.env

# -------------------------------------------------------------------------
# Configuration prefix

SERVICE=GATEWAY

# -------------------------------------------------------------------------
# Server

GATEWAY_SERVER_HOST=0.0.0.0
GATEWAY_SERVER_PORT=8080

# Options [ms, s, m, h]
GATEWAY_SERVER_SHUTDOWN_TIMEOUT=10s

# -------------------------------------------------------------------------
# LOGGER

# Options [dev, prod]
GATEWAY_LOGGER_FORMAT=dev

# -------------------------------------------------------------------------
# SWAGGER

# Options [true, false]
GATEWAY_SWAGGER_ENABLED=true

# -------------------------------------------------------------------------
# CORS

GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:3000

# [GET, POST, PUT, PATCH, DELETE, OPTIONS]
GATEWAY_CORS_ALLOWED_METHODS=GET;POST;PUT;PATCH;DELETE;OPTIONS

# [Content-Type, Authorization
GATEWAY_CORS_ALLOWED_HEADERS=Content-Type;Authorization

# [true, fasle]
GATEWAY_CORS_ALLOW_CREDENTIALS=true